# ============================================================================
# Storefront Next - Configuration (Foundations)
# ============================================================================
# Two kinds of variables live here:
#   1. REQUIRED to boot or deploy: the B2C Commerce API credentials below.
#   2. Site identity for this storefront: the site context and its locales.
#      These have defaults in config.server.ts, but are set here so a fresh
#      clone renders the Foundations site (en-US / USD) out of the box. This
#      file is the single obvious place to change the site your storefront
#      serves; edit config.server.ts for anything more involved.
# Everything else keeps its config.server.ts default.
#
# To enable optional features (hybrid proxy, Marketing Cloud, Turnstile,
# multi-site, commerce agent, etc.), see:
#   - Get started:           README.md
#   - Full reference:        docs/README-CONFIG.md
#   - All config options:    docs/README-CONFIG-OPTIONS.md
# ============================================================================

# ----------------------------------------------------------------------------
# Managed Runtime Deployment (used by `pnpm push`)
# These are read by the storefront-next-dev CLI; they are not runtime config.
# ----------------------------------------------------------------------------
MRT_PROJECT=my-project-slug
MRT_TARGET=development

# ----------------------------------------------------------------------------
# B2C Commerce API credentials (REQUIRED for the storefront to call SCAPI)
# Fill these with the credentials for the backend that hosts your Foundations
# site before running or deploying. Unlike the other verticals, there is no
# shared public demo backend for Foundations, so these ship empty.
# ----------------------------------------------------------------------------
PUBLIC__app__commerce__api__clientId=
PUBLIC__app__commerce__api__organizationId=
PUBLIC__app__commerce__api__shortCode=

# ----------------------------------------------------------------------------
# Site context (Foundations)
# A default clone renders the Foundations site (en-US / USD) instead of the
# canonical RefArchGlobal default. `commerce.sites` fully replaces the default
# site list, and `defaultSiteId` must name a site in it.
# ----------------------------------------------------------------------------
PUBLIC__app__defaultSiteId=Foundations
PUBLIC__app__commerce__sites=[{"id":"Foundations","defaultLocale":"en-US","defaultCurrency":"USD","supportedLocales":[{"id":"en-US","preferredCurrency":"USD"}],"supportedCurrencies":["USD"]}]

# ----------------------------------------------------------------------------
# Internationalization (Foundations ships en-US only)
# ----------------------------------------------------------------------------
PUBLIC__app__i18n__fallbackLng=en-US
PUBLIC__app__i18n__supportedLngs=["en-US"]
